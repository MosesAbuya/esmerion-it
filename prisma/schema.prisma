generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   String                   @id @default(cuid())
  name                 String
  slug                 String                   @unique
  baseCurrency         String                   @default("KES")
  parentOrganizationId String?
  parentOrganization   Organization?            @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations   Organization[]           @relation("OrganizationHierarchy")
  type                 String                   @default("INTERNAL") // INTERNAL | SUBSCRIBER
  plan                 String?
  settings             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  memberships          Membership[]
  modules              OrganizationModule[]
  roles                Role[]
  invitations          OrganizationInvitation[]
  auditLogs            AuditLog[]
  ledgerAccounts       LedgerAccount[]
  journalEntries       JournalEntry[]
  journalLines         JournalLine[]
  clients              Client[]
  projects             Project[]
  tenders              Tender[]
  assets               Asset[]
  articles             Article[]
  pressReleases        PressRelease[]
  mediaContacts        MediaContact[]
  adCampaigns          AdCampaign[]
  subscribers          Subscriber[]
  allocationsAsParent  AllocationRule[]         @relation("AllocationRuleParent")
  allocationsAsChild   AllocationRule[]         @relation("AllocationRuleChild")
}

model User {
  id                 String                   @id @default(cuid())
  name               String?
  email              String                   @unique
  emailVerified      DateTime?
  image              String?
  isSystemSuperadmin Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  memberships        Membership[]
  accounts           Account[]
  sessions           Session[]
  Authenticator      Authenticator[]
  invitationsSent    OrganizationInvitation[]
  auditLogs          AuditLog[]
  journalsCreated    JournalEntry[]           @relation("JournalCreatedBy")
  journalsPosted     JournalEntry[]           @relation("JournalPostedBy")
  tasks              Task[]
  assets             Asset[]
  articles           Article[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("MEMBER") // OWNER, ADMIN, MANAGER, MEMBER, VIEWER
  status         String       @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
}

model Role {
  id             String        @id @default(cuid())
  organizationId String? // nullable for system default
  name           String
  permissions    Json
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  key                 String               @id
  name                String
  organizationModules OrganizationModule[]
}

model OrganizationModule {
  organizationId String
  moduleKey      String
  enabled        Boolean      @default(true)
  enabledAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         Module       @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@id([organizationId, moduleKey])
}

model SystemConfig {
  key   String @id
  value Json
}

model OrganizationInvitation {
  id             String   @id @default(cuid())
  email          String
  organizationId String
  role           String   @default("MEMBER")
  token          String   @unique
  expiresAt      DateTime
  inviterId      String
  status         String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationId])
}

model AuditLog {
  id             String  @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  resource       String
  details        Json?

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model LedgerAccount {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  parentId       String?
  currency       String?
  isIntercompany Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         LedgerAccount?   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       LedgerAccount[]  @relation("AccountHierarchy")
  journalLines   JournalLine[]
  clients        Client[]
  projects       Project[]
  tenders        Tender[]
  assets         Asset[]
  articles       Article[]
  pressReleases  PressRelease[]
  mediaContacts  MediaContact[]
  adCampaigns    AdCampaign[]
  subscribers    Subscriber[]
  allocationsOut AllocationRule[] @relation("SourceAccount")
  allocationsIn  AllocationRule[] @relation("TargetAccount")

  @@unique([organizationId, code])
}

model JournalEntry {
  id             String    @id @default(cuid())
  organizationId String
  date           DateTime
  description    String
  sourceType     String // MANUAL, RECEIPT, INVOICE, TENDER_PAYMENT, AD_SALE, PAYROLL, TRANSFER
  sourceId       String?
  currency       String    @default("KES")
  exchangeRate   Decimal   @default(1.0)
  status         String    @default("DRAFT") // DRAFT, POSTED, VOIDED
  reversalOfId   String?
  createdById    String?
  postedById     String?
  postedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  postedBy     User?          @relation("JournalPostedBy", fields: [postedById], references: [id])
  reversalOf   JournalEntry?  @relation("JournalReversals", fields: [reversalOfId], references: [id])
  reversals    JournalEntry[] @relation("JournalReversals")
  lines        JournalLine[]

  @@index([organizationId, date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  organizationId String // Denormalized for tenant isolation
  debit          Decimal  @default(0) // Base currency
  credit         Decimal  @default(0) // Base currency
  txDebit        Decimal  @default(0) // Transaction currency
  txCredit       Decimal  @default(0) // Transaction currency
  description    String?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// === PHASE 4: MALSHE MEDIA OPERATIONS ===

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  industry       String?
  status         String   @default("LEAD") // LEAD, ACTIVE, FORMER
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  projects        Project[]
  adCampaigns     AdCampaign[]
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId String?
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  email     String?
  phone     String?
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Project {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  description    String?
  status         String    @default("PLANNING") // PLANNING, IN_PROGRESS, REVIEW, COMPLETED
  startDate      DateTime?
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks           Task[]
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId String?
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  title        String
  status       String    @default("TODO") // TODO, DOING, DONE
  assignedToId String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
}

model Tender {
  id                 String    @id @default(cuid())
  organizationId     String
  title              String
  issuingAuthority   String
  referenceNumber    String?
  status             String    @default("PREPARING") // EVALUATING, PREPARING, SUBMITTED, WON, LOST, CANCELLED
  estimatedValue     Decimal?  @db.Decimal(19, 4)
  submissionDeadline DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId String?
}

model Asset {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  category       String // IT, FURNITURE, CAMERA_GEAR, VEHICLE
  serialNumber   String?
  status         String    @default("AVAILABLE") // AVAILABLE, ASSIGNED, MAINTENANCE, RETIRED
  purchaseDate   DateTime?
  purchaseValue  Decimal?  @db.Decimal(19, 4)
  assignedToId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo      User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId String?
}

// === PHASE 5: TURNINGPOINT OPERATIONS ===

model Article {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  content        String?
  authorId       String?
  status         String    @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, PUBLISHED
  publishDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author          User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId String?
}

model PressRelease {
  id               String    @id @default(cuid())
  organizationId   String
  title            String
  content          String?
  distributionList String?
  status           String    @default("DRAFT") // DRAFT, DISTRIBUTED
  distributedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId String?
}

model MediaContact {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  outlet         String?
  email          String?
  phone          String?
  category       String? // TV, PRINT, RADIO, DIGITAL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId String?
}

model AdCampaign {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  campaignName   String
  budget         Decimal? @db.Decimal(19, 4)
  status         String   @default("PITCHED") // PITCHED, ACTIVE, COMPLETED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  placements      AdPlacement[]
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId String?
}

model AdPlacement {
  id          String    @id @default(cuid())
  campaignId  String
  platform    String // PRINT, WEB, SOCIAL
  publishDate DateTime?
  cost        Decimal?  @db.Decimal(19, 4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Subscriber {
  id               String    @id @default(cuid())
  organizationId   String
  name             String
  email            String
  subscriptionTier String    @default("BASIC") // BASIC, PREMIUM, CORPORATE
  status           String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId String?
}

// === PHASE 6: CONSOLIDATION & GROUP INTELLIGENCE ===

model AllocationRule {
  id                   String   @id @default(cuid())
  parentOrganizationId String
  childOrganizationId  String
  name                 String
  percentage           Decimal  @db.Decimal(5, 2) // e.g. 30.00
  sourceAccountId      String // LedgerAccount in Parent
  targetAccountId      String // LedgerAccount in Child
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  parentOrganization Organization  @relation("AllocationRuleParent", fields: [parentOrganizationId], references: [id], onDelete: Cascade)
  childOrganization  Organization  @relation("AllocationRuleChild", fields: [childOrganizationId], references: [id], onDelete: Cascade)
  sourceAccount      LedgerAccount @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  targetAccount      LedgerAccount @relation("TargetAccount", fields: [targetAccountId], references: [id], onDelete: Cascade)
}
